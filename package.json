{
  "name": "image-organizer",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"npm:dev -w apps/server\" \"npm:dev -w apps/web\"",
    "build": "npm run build -w packages/shared && npm run build -w apps/server && npm run build -w apps/web",
    "start": "npm run start -w apps/server",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "hash-password": "npm run hash-password -w apps/server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}

# Only sources needed to build go into the image context; everything is rebuilt inside.

# VCS / CI
.git
.gitignore
.github

# Docker files themselves (docker/ is needed: entrypoint + hash-password)
Dockerfile*
docker-compose*.yml
.dockerignore

# Editor / OS
**/.DS_Store
.idea
.vscode
*.swp

# Secrets
.env
.env.*
*.pem
*.key

# Dependencies & build output, in every workspace (installed/built inside the image)
**/node_modules
**/dist
**/build
**/.vite
**/*.tsbuildinfo

# Tests, fixtures, coverage, logs
**/*.test.ts
apps/server/test
vitest.config.ts
fixtures
coverage
test-results
playwright-report
**/*.log

# Local sandbox and dev tooling
.local-test
scripts

# Docs, screenshots and Claude context
*.md
docs
images
.claude
